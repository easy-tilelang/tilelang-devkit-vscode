{
  "folders": [{ "path": "." }],
  "launch": {
    "version": "0.2.0",
    "configurations": [{
      "name": "Run TileLang DevKit",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "build extension"
    }]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [{ "label": "build extension", "type": "shell", "command": "npm run build", "problemMatcher": [] }]
  }
}
